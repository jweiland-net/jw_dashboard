                <source>Enable Maintenance Contract Widget</source>
                <target state="translated">Widget „Wartungsvertrag“ aktivieren</target>
            </trans-unit>
            <trans-unit id="enableWidgetQuickLinks">
                <source>Enable Quick Links Widget</source>
                <target state="translated">Widget „Schnellzugriff“ aktivieren</target>
            </trans-unit>
            <trans-unit id="enableWidgetSiteHealth">
                <source>Enable Site Health Widget</source>
                <target state="translated">Widget „Website-Zustand“ aktivieren</target>
            </trans-unit>
            <trans-unit id="enableWidgetExtensionUpdates">
