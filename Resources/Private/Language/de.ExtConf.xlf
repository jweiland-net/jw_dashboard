            <trans-unit id="enableWidgetRecentChanges">
                <source>Enable Recently Changed Widget</source>
                <target state="translated">Widget „Zuletzt geändert“ aktivieren</target>
            </trans-unit>
            <trans-unit id="enableWidgetStorage">
                <source>Enable Storage Widget</source>
                <target state="translated">Widget „Speicher“ aktivieren</target>
            </trans-unit>
            <trans-unit id="activityWeeks">
                <source>Content Activity: number of weeks (1-52)</source>
                <target state="translated">Inhaltsaktivität: Anzahl der Wochen (1-52)</target>
            </trans-unit>
            <trans-unit id="recentChangesCount">
                <source>Recently Changed: number of records (1-25)</source>
                <target state="translated">Zuletzt geändert: Anzahl der Datensätze (1-25)</target>
